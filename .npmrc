# React Native's Metro bundler cannot follow pnpm's default symlinked layout — it fails to
# resolve packages' own transitive dependencies (expo → expo-modules-core). Expo documents
# `node-linker=hoisted` as the supported layout for pnpm monorepos.
#
# Removing this breaks `apps/mobile` bundling, not just its install. Verify with
# `npx expo export --platform android` before changing it.
node-linker=hoisted
